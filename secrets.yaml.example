# Copy this file to "secrets.yaml" (same folder) and fill in real values.
# secrets.yaml is read by kc868-a6.yaml and must NEVER be committed/shared.

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"
ap_fallback_password: "kc868fallback"

# 32-byte base64 key for the ESPHome native API. Generate your own with:
#   python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
encryption_key: "REPLACE_WITH_YOUR_OWN_GENERATED_KEY="

ota_password: "choose-a-strong-ota-password"

# MQTT broker — using the public test.mosquitto.org broker (port 1883,
# no login required). kc868-a6.yaml already keeps its topics under the
# unique prefix "pkru/19_04_10_28" so it won't collide with other people
# using the same public broker.
#
# NOTE: test.mosquitto.org is a public, unauthenticated broker meant for
# testing — anyone who knows/guesses your topic prefix could see or
# control your relays. Fine for trying things out; switch to the private
# broker in docker-compose.yml (see README) for real/permanent use.
mqtt_broker: "test.mosquitto.org"
